FROM postgres:18-bookworm
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backup-requirements.txt .
RUN python3 -m venv /opt/backup-venv \
    && /opt/backup-venv/bin/pip install --no-cache-dir -r backup-requirements.txt
COPY qa ./qa
ENV PATH="/opt/backup-venv/bin:${PATH}" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER postgres
ENTRYPOINT []
CMD ["python", "-m", "qa.scheduled_backup", "run"]
